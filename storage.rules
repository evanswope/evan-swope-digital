rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /dates/{imageId} {
      // Anyone can view the high score memories
      allow read: if true;
      // Anyone can upload a date memory portrait under 5MB
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
